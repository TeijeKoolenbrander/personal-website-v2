---
interface Props {
  title: string;
  subtitle?: string;
  /** Bottom padding of the block; Projects uses a tighter value because the filter follows. */
  tight?: boolean;
}
const { title, subtitle, tight = false } = Astro.props;
---

<section class:list={['container', 'page-title', { tight }]}>
  <div class="row">
    <h1>{title}</h1>
    <slot />
  </div>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</section>

<style>
  .page-title {
    padding-top: var(--space-44);
    padding-bottom: var(--space-40);
  }
  .page-title.tight {
    padding-bottom: var(--space-36);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-24);
  }
  h1 {
    font-size: var(--text-title);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-display);
  }
  .subtitle {
    margin-top: var(--space-20);
    font-size: var(--text-22);
    font-style: italic;
    line-height: var(--leading-normal);
  }
</style>
