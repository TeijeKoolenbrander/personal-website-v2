---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  logo?: ImageMetadata;
  mark?: 'circle-line' | 'squares' | 'triangle';
  alt?: string;
}
const { logo, mark = 'circle-line', alt = '' } = Astro.props;
---

{
  logo ? (
    <Image src={logo} alt={alt} width={72} height={72} class="logo" loading="lazy" />
  ) : (
    <svg width="72" height="72" style="width:4.5rem;height:4.5rem" viewBox="0 0 72 72" aria-hidden="true" focusable="false">
      <rect class="ln" x="0.5" y="0.5" width="71" height="71" />
      {mark === 'circle-line' && (
        <>
          <circle class="ln" cx="36" cy="36" r="16" />
          <path class="ln" d="M14,36 H58" />
        </>
      )}
      {mark === 'squares' && (
        <>
          <rect class="ln" x="18" y="18" width="24" height="24" />
          <rect class="ln" x="30" y="30" width="24" height="24" />
        </>
      )}
      {mark === 'triangle' && (
        <>
          <path class="ln" d="M36,16 L56,54 H16 Z" />
          <circle cx="36" cy="42" r="3" fill="currentColor" />
        </>
      )}
    </svg>
  )
}

<style>
  .logo {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
  }
</style>
