---
import type { projectIcons } from '../../content.config';

interface Props {
  name: (typeof projectIcons)[number];
  size?: number;
  /** Draw the strokes on load (project detail page only). */
  animate?: boolean;
}
const { name, size = 44, animate = false } = Astro.props;
const ln = animate ? 'ln draw' : 'ln';
const pl = animate ? 1 : undefined;
---

<svg width={size} height={size} style={`width:${size / 16}rem;height:${size / 16}rem`} viewBox="0 0 44 44" aria-hidden="true" focusable="false" class="project-icon">
  {
    name === 'window' && (
      <>
        <rect class={ln} pathLength={pl} x="3" y="7" width="38" height="30" rx="2" />
        <path class={ln} pathLength={pl} d="M3,14 H41 M10,22 L15,26 L10,30 M19,30 H27" />
      </>
    )
  }
  {
    name === 'chip' && (
      <>
        <rect class={ln} pathLength={pl} x="12" y="12" width="20" height="20" rx="1" />
        <path
          class={ln}
          pathLength={pl}
          d="M17,12 V5 M22,12 V5 M27,12 V5 M17,32 V39 M22,32 V39 M27,32 V39 M12,17 H5 M12,22 H5 M12,27 H5 M32,17 H39 M32,22 H39 M32,27 H39"
        />
      </>
    )
  }
  {
    name === 'rings' && (
      <>
        <circle class={ln} pathLength={pl} cx="22" cy="22" r="4" />
        <circle class={ln} pathLength={pl} cx="22" cy="22" r="11" />
        <circle class={ln} pathLength={pl} cx="22" cy="22" r="18" />
      </>
    )
  }
  {
    name === 'chart' && (
      <>
        <path class={ln} pathLength={pl} d="M5,5 V39 H39 M9,32 Q15,10 21,24 T33,12" />
        <circle cx="33" cy="12" r="2.5" fill="currentColor" />
      </>
    )
  }
  {
    name === 'signal' && (
      <>
        <path class={ln} pathLength={pl} d="M15,27 Q22,20 29,27 M10,22 Q22,10 34,22 M5,17 Q22,0 39,17" />
        <circle cx="22" cy="33" r="2.5" fill="currentColor" />
      </>
    )
  }
  {
    name === 'layers' && (
      <path class={ln} pathLength={pl} d="M22,6 L40,15 L22,24 L4,15 Z M4,22 L22,31 L40,22 M4,29 L22,38 L40,29" />
    )
  }
  {
    name === 'dice' && (
      <>
        <rect class={ln} pathLength={pl} x="5" y="5" width="34" height="34" rx="4" />
        <circle cx="14" cy="14" r="2" fill="currentColor" />
        <circle cx="22" cy="22" r="2" fill="currentColor" />
        <circle cx="30" cy="30" r="2" fill="currentColor" />
        <circle cx="30" cy="14" r="2" fill="currentColor" />
        <circle cx="14" cy="30" r="2" fill="currentColor" />
      </>
    )
  }
  {
    name === 'gamepad' && (
      <>
        <path
          class={ln}
          pathLength={pl}
          d="M12,11 H32 Q39,11 41,20 L42,30 Q42,36 37,36 Q33,36 31,31 H13 Q11,36 7,36 Q2,36 2,30 L3,20 Q5,11 12,11 Z M13,17 V27 M8,22 H18"
        />
        <circle class={ln} pathLength={pl} cx="30" cy="19" r="2" />
        <circle class={ln} pathLength={pl} cx="35" cy="24" r="2" />
      </>
    )
  }
</svg>

<style>
  .project-icon {
    flex: none;
  }
</style>
