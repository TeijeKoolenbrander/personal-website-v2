---
import type { CollectionEntry } from 'astro:content';

interface Props {
  milestones: CollectionEntry<'milestones'>[];
}
const { milestones } = Astro.props;
---

<ol class="timeline" role="list">
  {
    milestones.map((m) => (
      <li class:list={{ current: m.data.current }}>
        <span class="label">{m.data.label}</span>
        <span class="dot" aria-hidden="true" />
        <p class="title">{m.data.title}</p>
        {m.data.note && <p class="note">{m.data.note}</p>}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    margin-left: var(--timeline-gutter);
    border-left: var(--rule);
  }
  li {
    position: relative;
    padding: 0 0 var(--space-28) 1.625rem;
  }
  li:last-child {
    padding-bottom: 0;
  }
  .label {
    position: absolute;
    left: calc(var(--timeline-gutter) * -1);
    top: 0.1875rem;
    font-size: var(--text-15);
  }
  .dot {
    position: absolute;
    left: -0.25rem;
    top: 0.5625rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-ink);
  }
  .current .dot {
    left: -0.3125rem;
    background: var(--color-paper);
    border: var(--rule);
  }
  .title {
    font-size: var(--text-20);
    line-height: var(--leading-normal);
  }
  .note {
    margin-top: var(--space-2);
    font-size: var(--text-15);
    font-style: italic;
  }
</style>
