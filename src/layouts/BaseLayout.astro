---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/tokens.css';
import '../styles/global.css';
import fontLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import SiteHeader from '../components/layout/SiteHeader.astro';
import type { NavKey } from '../components/layout/SiteHeader.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  currentNav?: NavKey | null;
  currentIsSection?: boolean;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  currentNav = null,
  currentIsSection = false,
  ogImage = '/og-default.png',
  noindex = false,
  jsonLd,
} = Astro.props;

// Always trailing-slash form (except for file paths like /sitemap.xml), regardless of how the page was requested.
const canonicalPath = /\/$|\.[a-z0-9]+$/i.test(Astro.url.pathname) ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = noindex ? undefined : new URL(canonicalPath, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, computer engineering student`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={currentNav} currentIsSection={currentIsSection} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
