# Cloudflare Pages custom headers. No Content-Security-Policy on purpose:
# the site uses inline JSON-LD and a small inline script, which a strict CSP would block.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# No Cache-Control on /*: Pages joins duplicate header values with commas, so each
# path below gets exactly one value, and everything else uses the Pages default.

# Hashed build assets never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og-default.png
  Cache-Control: public, max-age=604800
